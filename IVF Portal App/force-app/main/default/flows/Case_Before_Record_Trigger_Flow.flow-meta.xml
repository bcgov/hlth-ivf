    <environments>Default</environments>
    <formulas>
        <name>CalcAvailableBalance</name>
        <dataType>Number</dataType>
        <expression>{!$Record.ApprovedTreatmentFunding__c}
- {!$Record.TotalTreatmentCost__c}
- IF(
    ISBLANK({!$Record.TotalMedicationCost__c}),
    0,
    IF(
        {!$Record.TotalMedicationCost__c} &gt; 
        ({!$Record.ApprovedTreatmentFunding__c} - {!$Record.TotalTreatmentCost__c}),
        ({!$Record.ApprovedTreatmentFunding__c} - {!$Record.TotalTreatmentCost__c}),
        {!$Record.TotalMedicationCost__c}
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>IVF_Allocate_Balance_Value</name>
        <dataType>Number</dataType>
        <expression>VALUE({!$Label.IVF_Allocate_Balance})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Monthspassed</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.Treatmentstartdate__c}, 15)</expression>
    </formulas>
    <formulas>
