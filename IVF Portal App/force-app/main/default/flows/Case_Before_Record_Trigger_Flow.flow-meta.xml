<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Deduct_Balance</name>
        <label>Deduct Balance</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>Get_Clinic_Funding_Records.AvailableBalance__c</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>IVF_Allocate_Balance_Value</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Clinics_Available_Balance</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Capacity_Reached_Error</name>
        <label>Capacity Reached Error</label>
        <locationX>314</locationX>
        <locationY>755</locationY>
        <customErrorMessages>
            <errorMessage>Your clinic has reached capacity. Unfortunately, no more applications can be accepted at this time.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Application_Status_Changes</name>
        <label>Application Status Changes</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Application_Submitted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Clinic_Funding_Records</targetReference>
            </connector>
            <label>Application Submitted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Available_Balance</name>
        <label>Check Available Balance</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sufficient_Balance</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Clinic_Funding_Records.AvailableBalance__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>IVF_Allocate_Balance_Value</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Deduct_Balance</targetReference>
            </connector>
            <label>Sufficient Balance</label>
        </rules>
        <rules>
            <name>Insufficient_Balance</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Clinic_Funding_Records.AvailableBalance__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>IVF_Allocate_Balance_Value</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capacity_Reached_Error</targetReference>
            </connector>
            <label>Insufficient Balance</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Status_Changed</name>
        <label>Is Status Changed?</label>
        <locationX>1106</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Application_Status_Changes</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
        <rules>
            <name>Funding_Utilized</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AvailableTreatmentBalance1__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FundingComplete__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Treatment_Reason_and_Complete</targetReference>
            </connector>
            <label>Funding Utilized</label>
        </rules>
        <rules>
            <name>MSP_Not_Enrolled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Applicant1MSPStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Enrolled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Applicant1MSPStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Enrolled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_MSP_Not_Enrolled_Reason</targetReference>
            </connector>
            <label>MSP Not Enrolled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
