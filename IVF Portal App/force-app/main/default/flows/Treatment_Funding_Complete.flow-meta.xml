<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <decisions>
        <name>Check_15_months_or_more</name>
        <label>Check 15 months or more</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X15_Months_Passed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Months</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>TodayDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Funding_Complete</targetReference>
            </connector>
            <label>15 Months Passed</label>
        </rules>
    </decisions>
    <decisions>
        <name>IS_IVF_Treatment</name>
        <label>IS IVF Treatment</label>
        <locationX>380</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Treatment_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IVFTreatment</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_15_months_or_more</targetReference>
            </connector>
            <label>Treatment Record ?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Months</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.Treatmentstartdate__c}, 15)</expression>
    </formulas>
    <formulas>
        <name>TodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Treatment Funding Complete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Treatment Funding Complete</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Funding_Complete</name>
        <label>Set Funding Complete</label>
        <locationX>50</locationX>
        <locationY>468</locationY>
        <inputAssignments>
            <field>FundingCompleteReason__c</field>
            <value>
                <stringValue>12 months post Application approval</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FundingComplete__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IS_IVF_Treatment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Treatmentstartdate__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>FundingComplete__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-04-17</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
