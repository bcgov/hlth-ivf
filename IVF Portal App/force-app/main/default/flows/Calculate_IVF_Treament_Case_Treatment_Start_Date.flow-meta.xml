<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <decisions>
        <description>If the Parent Case - Date of Application Submission is greater than or equal to 2024-Apr-01, Treatment Start Date is updated.</description>
        <name>Date_of_Application_Submission_Check</name>
        <label>Date of Application Submission Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Greater_than_or_Equal_to_2024_04_01</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_IVF_Treatment_Case.Parent.DateOfApplicationSubmission__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <dateValue>2024-04-01</dateValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Treatment_Start_Date</targetReference>
            </connector>
            <label>Greater than or Equal to 2024-04-01</label>
        </rules>
    </decisions>
    <description>This flow automatically updates the Treatment Start Date on an IVF Treatment Case based on the Treatment Date of the earliest-created Treatment Cost Line Item related to that Case.</description>
    <environments>Default</environments>
    <interviewLabel>IVF - Update Treatment Start Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Calculate IVF Treament Case - Treatment Start Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Earliest_IVF_Treatment_Line_Item</name>
        <label>Get Earliest IVF Treatment Line Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Date_of_Application_Submission_Check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_IVF_Treatment_Case.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>TreatmentDate__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>IVFTreatmentLineItem__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_IVF_Treatment_Case</name>
        <label>Get IVF Treatment Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Earliest_IVF_Treatment_Line_Item</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Case_Treatment_Start_Date</name>
        <label>Update Case - Treatment Start Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_IVF_Treatment_Case.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Treatment_Start_Date__c</field>
            <value>
                <elementReference>Get_Earliest_IVF_Treatment_Line_Item.TreatmentDate__c</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_IVF_Treatment_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>IVFTreatmentLineItem__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
