    <decisions>
        <name>Check_Status_Change</name>
        <label>Check Status Change</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>ConfirmStatusUpdateApprovedNotApproved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Approved Or Not Approved</defaultConnectorLabel>
        <rules>
            <name>In_Review_Or_Changes_Requested</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>NewStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>InReview</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ChangesRequested</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirm_Status_Update</targetReference>
            </connector>
            <label>In Review Or Changes Requested</label>
        </rules>
    </decisions>
    <decisions>
        <name>Confirm_Status_Update</name>
        <label>Confirm Status Update</label>
        <locationX>314</locationX>
        <locationY>650</locationY>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>Proceed_with_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewStatus</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Status</targetReference>
            </connector>
            <label>Proceed with Update</label>
        </rules>
    </decisions>
