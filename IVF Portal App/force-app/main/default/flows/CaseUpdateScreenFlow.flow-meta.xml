        </connector>
        <fields>
            <name>ApprovedWithMSPIncomplete</name>
            <fieldText>&lt;p&gt;Warning: The MSP eligibility check for at least one of the beneficiaries has not been completed. Are you sure you want to proceed with changing the status to Approved? Please note that once this action is performed, further updates to the application will not be permitted.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>NewStatus</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Approved</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Get_Case_Record.MSPCoverageStatus__c</leftValueReference>
                    <operator>NotEqualTo</operator>
                    <rightValue>
                        <stringValue>All Enrolled</stringValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Get_Case_Record.TotalHouseholdIncome__c</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Get_Case_Record.NOARecevied__c</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Yes</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ApprovedWithMSPComplete</name>
            <fieldText>&lt;p&gt;Warning: Are you sure you want to proceed with changing the status to Approved? Please note that once this action is performed, further updates to the application will not be permitted.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>NewStatus</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Approved</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Get_Case_Record.MSPCoverageStatus__c</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>All Enrolled</stringValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Get_Case_Record.TotalHouseholdIncome__c</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Get_Case_Record.NOARecevied__c</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Yes</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>NotApprovedMessage</name>
            <fieldText>&lt;p&gt;Warning: Are you sure you want to proceed with changing the status to Not Approved? Please note that once this action is performed, further updates to the application will not be permitted.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>NewStatus</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>NotApproved</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>NoHouseholdIncomeORNOA</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;background-color: rgba(5, 21, 36, 0); font-size: 14px; font-family: &amp;quot;Atlassian Sans&amp;quot;, ui-sans-serif, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Ubuntu, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; color: rgb(41, 42, 46);&quot;&gt;The application cannot be moved to Approved. Please ensure the Household Income and NOA Received fields are filled in.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>1 AND (2 OR 3)</conditionLogic>
                <conditions>
                    <leftValueReference>NewStatus</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Approved</elementReference>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Get_Case_Record.TotalHouseholdIncome__c</leftValueReference>
                    <operator>LessThanOrEqualTo</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>Get_Case_Record.NOARecevied__c</leftValueReference>
                    <operator>NotEqualTo</operator>
                    <rightValue>
                        <stringValue>Yes</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
