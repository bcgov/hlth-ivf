<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Add_Medication_Cost</name>
        <label>Add Medication Cost</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>TotalMedicationCost</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Medication_Cost_Line_Items.Medication_Cost__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Medication_Cost_Line_Items</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Case_Total_Medication_Cost</name>
        <label>Set Case Total Medication Cost</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Related_Case.TotalMedicationCost__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TotalMedicationCost</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_First_Medication_Cost_Line_Item</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Medication_Start_Date</name>
        <label>Set Medication Start Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Related_Case.Medication_Start_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Medication_Date__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Related_Case</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Block_Medication_Cost_Line_Item_for_Funding_Complete</name>
        <label>Block Medication Cost Line Item for Funding Complete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Medication Costs cannot be added because funding is complete</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Medication_Cost_Exceeds_Available_Cost</name>
        <label>Medication Cost Exceeds Available Cost</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Medication cost entered is exceeding the available balance {!RemainingAvailableAmount} on the application.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Is_First_Medication_Cost_Line_Item</name>
        <label>Is First Medication Cost Line Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Related_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>First_Medication_Cost_Line_Item</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Case.Medication_Start_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Medication_Start_Date</targetReference>
            </connector>
            <label>First Medication Cost Line Item</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Valid_Related_Case_Found</name>
        <label>Is Valid Related Case Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Block_Medication_Cost_Line_Item_for_Funding_Complete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Valid_Related_Case_Found</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Case.FundingComplete__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.IVF_Finance_Controls__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Validate_Medication_Cost_Against_Available_Balance</targetReference>
            </connector>
            <label>Valid Related Case Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validate_Medication_Cost_Against_Available_Balance</name>
        <label>Validate Medication Cost Against Available Balance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Related_Medication_Cost_Line_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Medication_Cost_Exceeds_Available_Balance</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>MedicationCostChange</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>RemainingAvailableAmount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.IVF_Finance_Controls__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RemainingAvailableAmount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Medication_Cost_Exceeds_Available_Cost</targetReference>
            </connector>
            <label>Medication Cost Exceeds Available Balance</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>MedicationCostChange</name>
        <dataType>Currency</dataType>
        <expression>IF(
    ISBLANK({!$Record__Prior.Id}),
    {!$Record.Medication_Cost__c},
    {!$Record.Medication_Cost__c} - {!$Record__Prior.Medication_Cost__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RemainingAvailableAmount</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Related_Case.AvailableTreatmentBalance1__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Calculate Total Medication Cost From Medication CostLine Items {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Calculate Total MedicationCost From Medication CostLine Items</label>
    <loops>
        <name>Loop_Medication_Cost_Line_Items</name>
        <label>Loop Medication Cost Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Related_Medication_Cost_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Medication_Cost</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Case_Total_Medication_Cost</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Related_Case</name>
        <label>Get Related Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Valid_Related_Case_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Medication_Cost_Line_Items</name>
        <label>Get Related Medication Cost Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Medication_Cost_Line_Items</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Medication_Cost_Line_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Related_Case</name>
        <label>Update Related Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Related_Case</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Case</targetReference>
        </connector>
        <filterFormula>AND(
    NOT(ISBLANK({!$Record.ParentId__c})),
    OR(
        ISNEW(),
        ISCHANGED({!$Record.Medication_Cost__c})
    )
)</filterFormula>
        <object>Medication_Cost_Line_Item__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>TotalMedicationCost</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
