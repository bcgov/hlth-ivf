  }, {
    "components" : [ {
      "componentAttributes" : {
        "richTextValue" : "<div style=\"background-color: #1e2a38; color: white; padding: 40px 20px; text-align: center;\">\n  <h1 style=\"font-size: 2.5rem; margin-bottom: 10px;\">Get in touch</h1>\n  <p style=\"font-size: 1.2rem; max-width: 600px; margin: 0 auto;\">\n    Want to get in touch? We’d love to hear from you. Here’s how you can reach us.\n  </p>\n</div>\n\n<div style=\"display: flex; flex-wrap: wrap; justify-content: center; padding: 40px 20px; background-color: #f5f5f5;\">\n  \n  <!-- Image Section -->\n  <div style=\"flex: 1 1 300px; max-width: 500px; padding: 20px; text-align: center;\">\n    <img src=\"{!URLFOR($Resource.IVFContactUs)}\" alt=\"Contact Us Image\" style=\"width: 100%; max-width: 400px; border-radius: 8px;\">\n  </div>\n\n  <!-- Contact Info Section -->\n  <div style=\"flex: 1 1 300px; max-width: 500px; padding: 20px; background-color: white; border-radius: 8px; box-shadow: 0 0 8px rgba(0,0,0,0.1);\">\n    <h2 style=\"color: #1e2a38;\">Email Our Team</h2>\n    <p style=\"font-size: 1.1rem; color: #333;\">\n      For any inquiries related to the IVF Program, reach out to us at:\n    </p>\n    <p style=\"font-size: 1.1rem; font-weight: bold;\">\n      <a href=\"mailto:HLTH.IVF@gov.bc.ca\" style=\"color: #0070d2; text-decoration: underline;\">\n        HLTH.IVF@gov.bc.ca\n      </a>\n    </p>\n  </div>\n\n</div>"
      },
