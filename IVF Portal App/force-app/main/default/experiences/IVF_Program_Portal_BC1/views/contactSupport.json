      "componentAttributes" : {
        "richTextValue" : "<!-- Main Container -->\n<div style=\"display: flex; flex-wrap: wrap; background-color: #1e2a38; color: white; padding: 40px 0;\">\n\n  <!-- Left: Text Content -->\n  <div style=\"flex: 1 1 40%; padding: 40px;\">\n    <p style=\"font-size: 1.2rem;\">\n      <strong>Get in touch:</strong> If you have any questions regarding the IVF program or require technical support, please email \n<a href=\"mailto:HLTH.IVF@gov.bc.ca\" class=\"ivf-email-link\" style=\"color: #ffffff; text-decoration: underline;\">\n  HLTH.IVF@gov.bc.ca\n</a>\n\n</p>\n  </div>\n\n  <!-- Right: Enlarged Image -->\n  <div style=\"flex: 1 1 60%; padding: 20px; text-align: center;\">\n    <img src=\"/sfsites/c/resource/IVFContactUs\" alt=\"Contact Image\" style=\"width: 60%; border-radius: 8px;\">\n  </div>\n\n</div>"
      },
      "componentName" : "forceCommunity:htmlBlock",
