<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MedicallyEligible_is_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISNEW()),
NOT($RecordType.Name = &apos;IVF Treatment&apos;),
ISBLANK(Text(Applicant1MedicallyEligible__c))
)</errorConditionFormula>
    <errorDisplayField>Applicant1MedicallyEligible__c</errorDisplayField>
    <errorMessage>MedicallyEligible is Required for Applicant 1</errorMessage>
</ValidationRule>
