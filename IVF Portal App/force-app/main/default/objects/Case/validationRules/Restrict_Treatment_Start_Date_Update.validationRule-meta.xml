<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Treatment_Start_Date_Update</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
     RecordType.DeveloperName  = &apos;IVFTreatment&apos;,
    ISCHANGED(Treatment_Start_Date__c),
    NOT($User.IVF_Finance_Controls__c),
    $Profile.Name &lt;&gt; &apos;System Administrator&apos;)</errorConditionFormula>
    <errorMessage>You do not have permission to edit the Treatment Start Date</errorMessage>
</ValidationRule>
