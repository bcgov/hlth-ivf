<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DateOfFollowUpNoFutureDate</fullName>
    <active>true</active>
    <errorConditionFormula>AND ( NOT(ISBLANK(DateofFollowUp__c)), DateofFollowUp__c &gt;  TODAY() )</errorConditionFormula>
    <errorDisplayField>DateofFollowUp__c</errorDisplayField>
    <errorMessage>Future dates are not allowed for Date of follow up. Only current or past dates are allowed.</errorMessage>
</ValidationRule>
