<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OnHold_Reason_Require</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    
    NOT($RecordType.DeveloperName = &quot;IVFTreatment&quot;),
    OnHold__c = TRUE,
    ISBLANK(TEXT(OnHoldReason__c))
)</errorConditionFormula>
    <errorDisplayField>OnHoldReason__c</errorDisplayField>
    <errorMessage>Please select an &apos;On Hold Reason&apos; before saving.</errorMessage>
</ValidationRule>
