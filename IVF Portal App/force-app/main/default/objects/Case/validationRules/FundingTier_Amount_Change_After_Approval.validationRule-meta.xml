<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FundingTier_Amount_Change_After_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(FundingTier__c) || ISCHANGED(ApprovedTreatmentFunding__c),
    ISPICKVAL(Status, &quot;Approved&quot;)
)</errorConditionFormula>
    <errorMessage>You cannot edit the Funding Tier or Approved Treatment Funding after the application is approved.</errorMessage>
</ValidationRule>
