<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approval_without_Tier_Amount</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status, &quot;Approved&quot;) &amp;&amp;
(
    ISBLANK(FundingTier__c) ||
    ISBLANK(ApprovedTreatmentFunding__c)
)</errorConditionFormula>
    <errorMessage>Please select a funding tier and ensure funding amount fields are filled before approving the application.</errorMessage>
</ValidationRule>
