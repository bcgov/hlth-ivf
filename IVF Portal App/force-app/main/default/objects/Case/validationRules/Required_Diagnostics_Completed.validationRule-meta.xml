<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Diagnostics_Completed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($RecordType.Name = &apos;IVF Treatment&apos;),
    NOT(ISNEW()),
    ISBLANK(Text(Applicant1RequiredDiagnosticsCompleted__c))
)</errorConditionFormula>
    <errorDisplayField>Applicant2RequiredDiagnosticsCompleted__c</errorDisplayField>
    <errorMessage>Required Diagnostics Completed in Applicant 1 is Required</errorMessage>
</ValidationRule>
