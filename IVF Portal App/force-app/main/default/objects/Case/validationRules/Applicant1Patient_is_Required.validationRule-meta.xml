<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Applicant1Patient_is_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($RecordType.Name = &apos;IVF Treatment&apos;),
    NOT(ISNEW()),
    ISBLANK(Text(Applicant1Patient__c))
)</errorConditionFormula>
    <errorDisplayField>Applicant1Patient__c</errorDisplayField>
    <errorMessage>Patient is Required for Applicant 1</errorMessage>
</ValidationRule>
