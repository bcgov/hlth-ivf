<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Medication_Cost_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>this is used for validating the medication cost value</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Medication_Cost__c)),
    Medication_Cost__c &lt; 0
)</errorConditionFormula>
    <errorMessage>Medication Costs cannot be negative.</errorMessage>
</ValidationRule>
