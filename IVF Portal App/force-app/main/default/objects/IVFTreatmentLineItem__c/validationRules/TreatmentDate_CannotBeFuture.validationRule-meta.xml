<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TreatmentDate_CannotBeFuture</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(TreatmentDate__c)),
    TreatmentDate__c &gt; TODAY()
)</errorConditionFormula>
    <errorMessage>Treatment Date cannot be in the future. Please enter today’s date or a past date.</errorMessage>
</ValidationRule>
