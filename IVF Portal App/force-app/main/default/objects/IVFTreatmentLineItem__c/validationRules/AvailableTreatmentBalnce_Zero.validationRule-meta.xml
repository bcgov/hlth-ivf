<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AvailableTreatmentBalnce_Zero</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISNEW(),
NOT(ISBLANK(ParentId__c)),
OR(
ParentId__r.AvailableTreatmentBalance1__c &lt;= 0,
ISNULL(ParentId__r.AvailableTreatmentBalance1__c)
)
)</errorConditionFormula>
    <errorMessage>Funding has been fully utilized.</errorMessage>
</ValidationRule>
