<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AvailableTreatmentBalnce_Zero</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISNEW(),
    NOT(ISBLANK(ParentId__c)),
    ParentId__r.AvailableTreatmentBalance__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Funding has been fully utilized.</errorMessage>
</ValidationRule>
